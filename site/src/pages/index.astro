---
import Layout from "../layouts/Layout.astro";
import Chain from "../islands/Chain.tsx";
import Code from "../islands/Code.tsx";
import Demo from "../islands/Demo.tsx";
import Field from "../islands/Field.tsx";
import Scopes from "../islands/Scopes.tsx";
import Thread from "../islands/Thread.tsx";

const repo = "https://github.com/dillon1000/bill";
const headline = ["Save", "hours", "of", "support", "every", "week."];

const reads = [
  { title: "Docs", body: "Any llms-full.txt, searched by term.", detail: "DocsPlugin" },
  { title: "Code", body: "One repo, read-only, with denied paths.", detail: "GitHubPlugin" },
  { title: "Account data", body: "Your plugin, bound to whoever is asking.", detail: "account:read" },
  { title: "History", body: "Their past tickets, feedback and email.", detail: "history:read" },
];

const acts = [
  { title: "hand_off", body: "To a person, with what it checked." },
  { title: "triage_ticket", body: "Priority, labels and internal notes." },
  { title: "close_ticket", body: "Only with the customer's own words." },
  { title: "file_issue", body: "After a duplicate search and a confirmed cause." },
];

const rules = [
  "Instructions only come from the system prompt.",
  "Never asks for passwords, tokens or cards.",
  "Never promises refunds, credits or unbans.",
  "Never confirms whether an account exists.",
  "Links only URLs a tool returned.",
  "Secrets are redacted in code, not by the prompt.",
];

const primitives = [
  ["generateText", "the tool loop"],
  ["stopWhen", "stepCountIs, hasToolCall"],
  ["prepareStep", "trim history, force an answer"],
  ["onStepFinish", "where each step is audited"],
  ["Tool.typed", "Decodable input, JSON Schema"],
  ["pruneMessages", "fit a token budget"],
];

const arrow = '<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>';
---

<Layout
  title="Bill: an open-source support agent with scoped tools and an audit log"
  description="A Swift package that answers support from your docs, code and account data. Tools are scoped per conversation and every step goes to a hash-chained log. MIT."
>
  <header class="top" data-over="hero">
    <div class="top-bar">
      <a href="/" class="mark" aria-label="Bill">
        <img class="mark-goose" src="/goose.svg" alt="" width="30" height="30" />
        <span class="mark-word">Bill</span>
      </a>
      <nav class="nav" aria-label="Sections">
        <a href="#demo">Replays</a>
        <a href="#scopes">Scopes</a>
        <a href="#audit">Audit log</a>
        <a href="#code">Code</a>
      </nav>
      <div class="top-actions">
        <a class="top-link" href={repo} aria-label="Bill on GitHub">
          <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.71 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.96 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.08-1.87 3.76-3.66 3.96.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z" /></svg>
        </a>
        <a class="btn top-cta" href={repo}>Get started</a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero" id="hero">
      <div class="field"><Field client:load /></div>
      <div class="veil" aria-hidden="true"></div>
      <div class="page hero-grid">
        <div class="hero-copy">
          <h1>
            {headline.map((w, i) => <span class="word" style={`--i:${i}`}>{w} </span>)}
          </h1>
          <p class="lede">An open-source Swift agent that answers support from your docs, code and customer data. Every tool is scoped. Every step is logged.</p>
          <div class="ctas">
            <a class="btn btn-light" href={repo}>Read the README <Fragment set:html={arrow} /></a>
            <a class="btn btn-outline-light" href="#demo">Watch the replays</a>
          </div>
        </div>
        <div class="hero-thread">
          <Thread client:load />
        </div>
      </div>
    </section>

    <section id="demo" class="section">
      <div class="page">
        <div class="head reveal">
          <h2>Replays</h2>
          <p>Real tool calls and audit events, in the order Bill writes them.</p>
        </div>
        <div class="reveal">
          <Demo client:visible />
        </div>
      </div>
    </section>

    <section class="section">
      <div class="page">
        <div class="head reveal">
          <h2>Reads and writes</h2>
        </div>
        <div class="tiles reveal">
          {
            reads.map((r) => (
              <article class="tile">
                <h3>{r.title}</h3>
                <p>{r.body}</p>
                <span class="tile-detail mono">{r.detail}</span>
              </article>
            ))
          }
        </div>
        <div class="tiles tiles-acts reveal">
          {
            acts.map((a) => (
              <article class="tile">
                <h3 class="mono">{a.title}</h3>
                <p>{a.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="scopes" class="section">
      <div class="page">
        <div class="head reveal">
          <h2>Scoped per conversation</h2>
          <p>Tools outside the grant never reach the model.</p>
        </div>
        <div class="reveal">
          <Scopes client:visible />
        </div>
      </div>
    </section>

    <section id="audit" class="section band">
      <div class="page">
        <div class="head reveal">
          <h2>Hash-chained audit log</h2>
          <p>Edit, forge or delete an event and verification fails.</p>
        </div>
        <div class="reveal">
          <Chain client:visible />
        </div>
      </div>
    </section>

    <section class="section">
      <div class="page split">
        <div class="head reveal">
          <h2>Fixed rules</h2>
          <p>Product prompts can add to these, not remove them.</p>
        </div>
        <ol class="rules reveal">
          {rules.map((r, i) => <li><span class="rule-n mono">{String(i + 1).padStart(2, "0")}</span>{r}</li>)}
        </ol>
      </div>
    </section>

    <section id="code" class="section">
      <div class="page split">
        <div class="head reveal">
          <h2>AI SDK primitives, in Swift</h2>
          <dl class="prims">
            {
              primitives.map(([name, what]) => (
                <>
                  <dt class="mono">{name}</dt>
                  <dd>{what}</dd>
                </>
              ))
            }
          </dl>
        </div>
        <div class="reveal">
          <Code client:visible />
        </div>
      </div>
    </section>

    <section class="section final">
      <div class="page final-inner reveal">
        <h2>Get started</h2>
        <pre class="install mono">.package(url: "https://github.com/dillon1000/bill.git", from: "0.1.0")</pre>
        <div class="ctas">
          <a class="btn btn-primary" href={repo}>Read the README <Fragment set:html={arrow} /></a>
          <a class="btn btn-secondary" href={`${repo}/tree/main/Sources/BillExample`}>Example app</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="page foot-inner">
      <span>MIT licensed. Goose from <a href="https://github.com/jdecked/twemoji">Twemoji</a>, CC BY 4.0.</span>
      <nav aria-label="Links">
        <a href={repo}>GitHub</a>
        <a href={`${repo}/blob/main/LICENSE`}>License</a>
      </nav>
    </div>
  </footer>
</Layout>

<script>
  // The header is iris glass while it floats over the hero, and white glass past it.
  const header = document.querySelector<HTMLElement>(".top");
  const hero = document.getElementById("hero");
  if (header && hero) {
    new IntersectionObserver(([entry]) => header.setAttribute("data-over", entry!.isIntersecting ? "hero" : "page"), {
      rootMargin: "-40px 0px -100% 0px",
    }).observe(hero);
  }
</script>

<style>
  /* A floating bar: frosted iris over the hero, frosted white once the page scrolls past it. */
  .top {
    position: fixed;
    top: 12px;
    left: 0;
    right: 0;
    z-index: 10;
    padding: 0 var(--gutter);
    pointer-events: none;
  }
  .top-bar {
    display: flex;
    align-items: center;
    gap: 28px;
    max-width: 1100px;
    height: 56px;
    margin: 0 auto;
    padding: 0 8px 0 14px;
    border-radius: 16px;
    corner-shape: squircle;
    pointer-events: auto;
    color: var(--text);
    background: rgba(255, 255, 255, 0.8);
    box-shadow:
      0 0 0 1px var(--line),
      0 12px 32px -12px rgba(17, 18, 20, 0.18);
    backdrop-filter: saturate(1.8) blur(18px);
    transition:
      background-color 300ms var(--ease),
      color 300ms var(--ease),
      box-shadow 300ms var(--ease);
  }
  .top[data-over="hero"] .top-bar {
    color: #fff;
    background: rgba(40, 20, 170, 0.28);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.22),
      0 12px 40px -16px rgba(20, 5, 110, 0.5);
  }
  .mark {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }
  .mark-goose {
    filter: drop-shadow(0 2px 4px rgba(20, 5, 110, 0.25));
    transition: transform 300ms var(--ease);
  }
  .mark:hover .mark-goose {
    transform: rotate(-8deg) translateY(-1px);
  }
  .mark-word {
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 500;
    line-height: 1;
  }
  .nav {
    display: flex;
    gap: 4px;
    font-size: 15px;
  }
  .nav a {
    padding: 7px 12px;
    border-radius: 9px;
    corner-shape: squircle;
    text-decoration: none;
    opacity: 0.78;
    transition:
      opacity 160ms var(--ease),
      background-color 160ms var(--ease);
  }
  .nav a:hover {
    opacity: 1;
    background: color-mix(in srgb, currentColor 10%, transparent);
  }
  .top-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }
  .top-link {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    corner-shape: squircle;
    opacity: 0.8;
    transition:
      opacity 160ms var(--ease),
      background-color 160ms var(--ease);
  }
  .top-link:hover {
    opacity: 1;
    background: color-mix(in srgb, currentColor 10%, transparent);
  }
  .top-cta {
    height: 40px;
    padding: 0 16px;
    font-size: 14px;
    background: var(--text);
    color: #fff;
  }
  .top-cta:hover {
    background: #2a2b2f;
  }
  .top[data-over="hero"] .top-cta {
    background: #fff;
    color: #3a26d6;
  }
  .top[data-over="hero"] .top-cta:hover {
    background: #f1efff;
  }
  @media (max-width: 760px) {
    .nav {
      display: none;
    }
  }

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding: clamp(112px, 12vw, 152px) 0 clamp(56px, 8vw, 96px);
    overflow: hidden;
    isolation: isolate;
    background: #5a49f6;
    color: #fff;
  }
  .field {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  /* A little depth at the bottom edge, so the white type holds up over the brightest streaks. */
  .veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 42% 48% at 22% 52%, rgba(52, 30, 205, 0.5), transparent 75%),
      radial-gradient(ellipse 32% 42% at 74% 48%, rgba(52, 30, 205, 0.38), transparent 75%),
      linear-gradient(to bottom, transparent 70%, rgba(40, 18, 170, 0.35));
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  @media (max-width: 1000px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  h1 {
    margin: 0 0 28px;
    font-size: clamp(54px, 7.2vw, 120px);
    line-height: 0.98;
    font-weight: 400;
  }
  .word {
    display: inline-block;
    white-space: pre;
    animation: word 1000ms var(--ease) both;
    animation-delay: calc(100ms + var(--i) * 65ms);
  }
  h1 {
    text-shadow: 0 2px 40px rgba(30, 10, 120, 0.25);
  }
  .word:nth-child(n + 5) {
    color: rgba(255, 255, 255, 0.66);
  }
  @keyframes word {
    from {
      opacity: 0;
      transform: translateY(0.45em) scale(0.96);
      filter: blur(10px);
    }
  }
  .lede {
    margin: 0 0 36px;
    max-width: 600px;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.86);
    animation: word 900ms var(--ease) 800ms both;
  }
  .btn-light {
    background: #fff;
    color: #3a26d6;
    box-shadow: 0 10px 30px -10px rgba(20, 5, 110, 0.6);
  }
  .btn-light:hover {
    background: #f1efff;
  }
  .btn-outline-light {
    color: #fff;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(6px);
  }
  .btn-outline-light:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .final .ctas {
    justify-content: center;
  }
  .hero-copy .ctas {
    animation: word 900ms var(--ease) 920ms both;
  }
  .hero-thread {
    animation: word 1100ms var(--ease) 600ms both;
  }

  .section {
    padding: clamp(72px, 10vw, 120px) 0;
    border-bottom: 1px solid var(--line);
  }
  .band {
    background: var(--surface);
  }
  .head {
    max-width: 720px;
    margin-bottom: 40px;
  }
  h2 {
    margin: 0 0 12px;
    font-size: clamp(34px, 4.4vw, 56px);
    line-height: 1.05;
    font-weight: 400;
  }
  .head p {
    margin: 0;
    font-size: 19px;
    line-height: 1.5;
    color: var(--text-dim);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .tiles-acts {
    border-top: 0;
  }
  @media (max-width: 1000px) {
    .tiles {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .tiles {
      grid-template-columns: 1fr;
    }
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 168px;
    padding: 24px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    transition: background-color 240ms var(--ease);
  }
  .tile::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    height: 2px;
    width: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 420ms var(--ease);
  }
  .tile:hover {
    background: var(--surface);
  }
  .tile:hover::before {
    transform: scaleX(1);
  }
  .tiles-acts .tile {
    min-height: 136px;
    background: var(--surface);
  }
  .tiles-acts .tile:hover {
    background: var(--frame);
  }
  .tile h3 {
    margin: 0;
    font-size: 20px;
    font-weight: 500;
  }
  .tile p {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-dim);
  }
  .tile-detail {
    margin-top: auto;
    font-size: 13px;
    color: var(--accent-text);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  @media (max-width: 960px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .rules {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .rules li {
    display: grid;
    grid-template-columns: 48px 1fr;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    font-size: 18px;
  }
  .rule-n {
    color: var(--accent-text);
    font-size: 14px;
    padding-top: 3px;
  }
  .prims {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px 20px;
    margin: 28px 0 0;
    font-size: 15px;
  }
  .prims dt {
    color: var(--accent-text);
  }
  .prims dd {
    margin: 0;
    color: var(--text-dim);
  }

  .final {
    border-bottom: 0;
  }
  .final-inner {
    max-width: 760px;
    text-align: center;
  }
  .install {
    margin: 8px auto 28px;
    max-width: 100%;
    width: fit-content;
    padding: 12px 16px;
    border-radius: 10px;
    corner-shape: squircle;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 14px;
    overflow-x: auto;
    text-align: left;
  }

  .foot {
    border-top: 1px solid var(--line);
    font-size: 14px;
    color: var(--text-faint);
  }
  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    padding-top: 28px;
    padding-bottom: 28px;
  }
  .foot nav {
    display: flex;
    gap: 20px;
  }
  .foot a {
    text-decoration: none;
  }
  .foot a:hover {
    color: var(--text);
  }

  @media (prefers-reduced-motion: reduce) {
    .word,
    .lede,
    .ctas,
    .field,
    .hero-thread {
      animation: none !important;
    }
  }
</style>
