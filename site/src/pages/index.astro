---
import Layout from "../layouts/Layout.astro";
import Chain from "../islands/Chain.tsx";
import Code from "../islands/Code.tsx";
import Demo from "../islands/Demo.tsx";
import Field from "../islands/Field.tsx";
import Scopes from "../islands/Scopes.tsx";
import Thread from "../islands/Thread.tsx";

const repo = "https://github.com/dillon1000/bill";
const headline = ["Save", "hours", "of", "support", "every", "week,", "with", "an", "agent", "you", "can", "audit."];

const reads = [
  { title: "Docs", body: "Any llms-full.txt, searched by term.", detail: "DocsPlugin" },
  { title: "Code", body: "One repo, read-only, with denied paths.", detail: "GitHubPlugin" },
  { title: "Account data", body: "Your plugin, bound to whoever is asking.", detail: "account:read" },
  { title: "History", body: "Their past tickets, feedback and email.", detail: "history:read" },
];

const acts = [
  { title: "hand_off", body: "To a person, with what it checked." },
  { title: "triage_ticket", body: "Priority, labels and internal notes." },
  { title: "close_ticket", body: "Only with the customer's own words." },
  { title: "file_issue", body: "After a duplicate search and a confirmed cause." },
];

const rules = [
  "Instructions only come from the system prompt.",
  "Never asks for passwords, tokens or cards.",
  "Never promises refunds, credits or unbans.",
  "Never confirms whether an account exists.",
  "Links only URLs a tool returned.",
  "Secrets are redacted in code, not by the prompt.",
];

const primitives = [
  ["generateText", "the tool loop"],
  ["stopWhen", "stepCountIs, hasToolCall"],
  ["prepareStep", "trim history, force an answer"],
  ["onStepFinish", "where each step is audited"],
  ["Tool.typed", "Decodable input, JSON Schema"],
  ["pruneMessages", "fit a token budget"],
];

const arrow = '<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>';
---

<Layout
  title="Bill: an open-source support agent with scoped tools and an audit log"
  description="A Swift package that answers support from your docs, code and account data. Tools are scoped per conversation and every step goes to a hash-chained log. MIT."
>
  <header class="top">
    <div class="page top-inner">
      <a href="/" class="mark" aria-label="Bill">
        <img src="/goose.svg" alt="" width="26" height="26" />
        <span>Bill</span>
      </a>
      <nav class="nav" aria-label="Sections">
        <a href="#demo">Replays</a>
        <a href="#scopes">Scopes</a>
        <a href="#audit">Audit log</a>
        <a href="#code">Code</a>
      </nav>
      <a class="btn btn-secondary top-cta" href={repo}>GitHub</a>
    </div>
  </header>

  <main>
    <section class="hero" id="hero">
      <div class="field"><Field client:load /></div>
      <div class="veil" aria-hidden="true"></div>
      <div class="page hero-grid">
        <div class="hero-copy">
          <h1>
            {headline.map((w, i) => <span class="word" style={`--i:${i}`}>{w} </span>)}
          </h1>
          <p class="lede">An open-source Swift agent that answers support from your docs, code and customer data. Every tool is scoped. Every step is logged.</p>
          <div class="ctas">
            <a class="btn btn-primary" href={repo}>Read the README <Fragment set:html={arrow} /></a>
            <a class="btn btn-secondary" href="#demo">Watch the replays</a>
          </div>
        </div>
        <div class="hero-thread">
          <Thread client:load />
        </div>
      </div>
    </section>

    <section id="demo" class="section">
      <div class="page">
        <div class="head reveal">
          <h2>Replays</h2>
          <p>Real tool calls and audit events, in the order Bill writes them.</p>
        </div>
        <div class="reveal">
          <Demo client:visible />
        </div>
      </div>
    </section>

    <section class="section">
      <div class="page">
        <div class="head reveal">
          <h2>Reads and writes</h2>
        </div>
        <div class="tiles reveal">
          {
            reads.map((r) => (
              <article class="tile">
                <h3>{r.title}</h3>
                <p>{r.body}</p>
                <span class="tile-detail mono">{r.detail}</span>
              </article>
            ))
          }
        </div>
        <div class="tiles tiles-acts reveal">
          {
            acts.map((a) => (
              <article class="tile">
                <h3 class="mono">{a.title}</h3>
                <p>{a.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="scopes" class="section">
      <div class="page">
        <div class="head reveal">
          <h2>Scoped per conversation</h2>
          <p>Tools outside the grant never reach the model.</p>
        </div>
        <div class="reveal">
          <Scopes client:visible />
        </div>
      </div>
    </section>

    <section id="audit" class="section band">
      <div class="page">
        <div class="head reveal">
          <h2>Hash-chained audit log</h2>
          <p>Edit, forge or delete an event and verification fails.</p>
        </div>
        <div class="reveal">
          <Chain client:visible />
        </div>
      </div>
    </section>

    <section class="section">
      <div class="page split">
        <div class="head reveal">
          <h2>Fixed rules</h2>
          <p>Product prompts can add to these, not remove them.</p>
        </div>
        <ol class="rules reveal">
          {rules.map((r, i) => <li><span class="rule-n mono">{String(i + 1).padStart(2, "0")}</span>{r}</li>)}
        </ol>
      </div>
    </section>

    <section id="code" class="section">
      <div class="page split">
        <div class="head reveal">
          <h2>AI SDK primitives, in Swift</h2>
          <dl class="prims">
            {
              primitives.map(([name, what]) => (
                <>
                  <dt class="mono">{name}</dt>
                  <dd>{what}</dd>
                </>
              ))
            }
          </dl>
        </div>
        <div class="reveal">
          <Code client:visible />
        </div>
      </div>
    </section>

    <section class="section final">
      <div class="page final-inner reveal">
        <h2>Get started</h2>
        <pre class="install mono">.package(url: "https://github.com/dillon1000/bill.git", from: "0.1.0")</pre>
        <div class="ctas">
          <a class="btn btn-primary" href={repo}>Read the README <Fragment set:html={arrow} /></a>
          <a class="btn btn-secondary" href={`${repo}/tree/main/Sources/BillExample`}>Example app</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="page foot-inner">
      <span>MIT licensed. Goose from <a href="https://github.com/jdecked/twemoji">Twemoji</a>, CC BY 4.0.</span>
      <nav aria-label="Links">
        <a href={repo}>GitHub</a>
        <a href={`${repo}/blob/main/LICENSE`}>License</a>
      </nav>
    </div>
  </footer>
</Layout>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .top-inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 64px;
  }
  .mark {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 18px;
    text-decoration: none;
  }
  .nav {
    display: flex;
    gap: 24px;
    font-size: 15px;
    color: var(--text-dim);
  }
  .nav a {
    text-decoration: none;
    transition: color 160ms var(--ease);
  }
  .nav a:hover {
    color: var(--text);
  }
  .top-cta {
    margin-left: auto;
    height: 36px;
    font-size: 14px;
  }
  @media (max-width: 720px) {
    .nav {
      display: none;
    }
  }

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: calc(100svh - 64px);
    padding: clamp(56px, 8vw, 96px) 0;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    isolation: isolate;
  }
  .field {
    position: absolute;
    inset: 0;
    z-index: -2;
    animation: word 1600ms var(--ease) 200ms both;
  }
  /* Keeps the text readable over the moving field without boxing anything in. */
  .veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 40% 52% at 24% 50%, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.45) 65%, transparent),
      radial-gradient(ellipse 30% 50% at 74% 50%, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.35) 65%, transparent),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.7), transparent 18%, transparent 82%, rgba(255, 255, 255, 0.85));
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  @media (max-width: 1000px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  h1 {
    margin: 0 0 28px;
    font-size: clamp(44px, 4.8vw, 80px);
    line-height: 0.98;
    font-weight: 400;
  }
  .word {
    display: inline-block;
    white-space: pre;
    animation: word 1000ms var(--ease) both;
    animation-delay: calc(100ms + var(--i) * 65ms);
  }
  .word:nth-child(n + 7) {
    color: var(--text-faint);
  }
  @keyframes word {
    from {
      opacity: 0;
      transform: translateY(0.45em) scale(0.96);
      filter: blur(10px);
    }
  }
  .lede {
    margin: 0 0 36px;
    max-width: 600px;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.5;
    color: var(--text-dim);
    animation: word 900ms var(--ease) 800ms both;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .final .ctas {
    justify-content: center;
  }
  .hero-copy .ctas {
    animation: word 900ms var(--ease) 920ms both;
  }
  .hero-thread {
    animation: word 1100ms var(--ease) 600ms both;
  }

  .section {
    padding: clamp(72px, 10vw, 120px) 0;
    border-bottom: 1px solid var(--line);
  }
  .band {
    background: var(--surface);
  }
  .head {
    max-width: 720px;
    margin-bottom: 40px;
  }
  h2 {
    margin: 0 0 12px;
    font-size: clamp(34px, 4.4vw, 56px);
    line-height: 1.05;
    font-weight: 400;
  }
  .head p {
    margin: 0;
    font-size: 19px;
    line-height: 1.5;
    color: var(--text-dim);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .tiles-acts {
    border-top: 0;
  }
  @media (max-width: 1000px) {
    .tiles {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .tiles {
      grid-template-columns: 1fr;
    }
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 168px;
    padding: 24px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    transition: background-color 240ms var(--ease);
  }
  .tile::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    height: 2px;
    width: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 420ms var(--ease);
  }
  .tile:hover {
    background: var(--surface);
  }
  .tile:hover::before {
    transform: scaleX(1);
  }
  .tiles-acts .tile {
    min-height: 136px;
    background: var(--surface);
  }
  .tiles-acts .tile:hover {
    background: var(--frame);
  }
  .tile h3 {
    margin: 0;
    font-size: 20px;
    font-weight: 500;
  }
  .tile p {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-dim);
  }
  .tile-detail {
    margin-top: auto;
    font-size: 13px;
    color: var(--accent-text);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  @media (max-width: 960px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .rules {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .rules li {
    display: grid;
    grid-template-columns: 48px 1fr;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    font-size: 18px;
  }
  .rule-n {
    color: var(--accent-text);
    font-size: 14px;
    padding-top: 3px;
  }
  .prims {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px 20px;
    margin: 28px 0 0;
    font-size: 15px;
  }
  .prims dt {
    color: var(--accent-text);
  }
  .prims dd {
    margin: 0;
    color: var(--text-dim);
  }

  .final {
    border-bottom: 0;
  }
  .final-inner {
    max-width: 760px;
    text-align: center;
  }
  .install {
    margin: 8px auto 28px;
    max-width: 100%;
    width: fit-content;
    padding: 12px 16px;
    border-radius: 10px;
    corner-shape: squircle;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 14px;
    overflow-x: auto;
    text-align: left;
  }

  .foot {
    border-top: 1px solid var(--line);
    font-size: 14px;
    color: var(--text-faint);
  }
  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    padding-top: 28px;
    padding-bottom: 28px;
  }
  .foot nav {
    display: flex;
    gap: 20px;
  }
  .foot a {
    text-decoration: none;
  }
  .foot a:hover {
    color: var(--text);
  }

  @media (prefers-reduced-motion: reduce) {
    .word,
    .lede,
    .ctas,
    .field,
    .hero-thread {
      animation: none !important;
    }
  }
</style>
